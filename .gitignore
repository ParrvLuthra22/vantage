# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
share/python-wheels/
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
.env.*
!.env.example
# Explicit belt-and-braces for the monorepo packages. The bare `.env` rule above
# already matches at any depth, but spelling these out means a future negation
# rule can't accidentally re-expose real credentials.
packages/**/.env
packages/**/.env.*
!packages/**/.env.example
# Local DB switcher holds the real Neon URL; only the .example is committed.
scripts/switch_db.sh

# Next.js local env files (the bare `.env`/`.env.*` rules above already match at
# any depth; these are spelled out because Next's own convention is .env*.local)
.env*.local
!.env.example

# Testing / coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Linting / type checking caches
.ruff_cache/
.mypy_cache/
.pytype/
.dmypy.json
dmypy.json

# Type stubs / build caches
.cache/

# Jupyter
.ipynb_checkpoints/

# Node / frontend (dashboard)
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs / local databases
*.log
*.sqlite3
# ...except docs/baselines/ exhibits — intentionally committed evidence, not
# throwaway debug output (referenced from README.md and docs/interview_exhibits/).
!docs/baselines/*.log

# Vesper's own local trace/audit output, written relative to CWD when
# running evals against --adapter vesper. `data/*` (not `data/`) so the two
# gold-set exceptions below can actually take effect — git cannot re-include
# a file whose PARENT DIRECTORY itself matched an exclude pattern, only one
# whose individual entry did.
packages/eval_engine/data/*
# ...except the gold-set labeling files — deliberately curated, committed
# source data for Week 5's judge-quality measurement, not Vesper runtime
# noise. See docs/gold_set_methodology.md.
!packages/eval_engine/data/gold_candidates.jsonl
!packages/eval_engine/data/gold_labels_v1.jsonl

# LLM judge fine-tuning data (scripts/collect_judge_traces.py): large,
# regenerable, not source. data/README.md documents it and IS tracked.
data/judge_traces*.jsonl
# The vantage SDK's local span fallback, written to ./data/traces/ when the
# API is unreachable. Keeps turning up as stray untracked files now that
# data/ holds something tracked.
data/traces/
