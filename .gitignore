# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
share/python-wheels/
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
.env.*
!.env.example
# Explicit belt-and-braces for the monorepo packages. The bare `.env` rule above
# already matches at any depth, but spelling these out means a future negation
# rule can't accidentally re-expose real credentials.
packages/**/.env
packages/**/.env.*
!packages/**/.env.example
# Local DB switcher holds the real Neon URL; only the .example is committed.
scripts/switch_db.sh

# Testing / coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Linting / type checking caches
.ruff_cache/
.mypy_cache/
.pytype/
.dmypy.json
dmypy.json

# Type stubs / build caches
.cache/

# Jupyter
.ipynb_checkpoints/

# Node / frontend (dashboard)
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs / local databases
*.log
*.sqlite3
