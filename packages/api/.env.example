# Copy to .env for local development. Never commit .env itself.
#
# Local dev (docker-compose)
DATABASE_URL=postgresql+asyncpg://vantage:vantage@localhost:5432/vantage

# Production (Neon) — set in Railway env vars, NOT here
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.aws.neon.tech/vantage?sslmode=require
#
# Note: Neon's console gives you a `postgresql://...` URL. Two changes are needed:
#   1. scheme  -> postgresql+asyncpg://   (SQLAlchemy needs the async driver)
#   2. sslmode -> handled automatically; database.py rewrites ?sslmode=require to
#      ?ssl=require, because asyncpg has no `sslmode` parameter and would
#      otherwise fail with "unexpected keyword argument 'sslmode'".

API_KEY=dev-key-change-me
CORS_ORIGINS=["http://localhost:3000"]
